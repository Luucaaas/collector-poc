# Modèle du fichier .env de la pile docker compose. `up.sh` crée .env à partir de ce modèle et
# remplace chaque valeur `change-me` par un mot de passe aléatoire. Aucun secret réel ici.
# .env est ignoré par git ; up.sh ne l'écrase jamais.

# PostgreSQL : superutilisateur d'administration et un utilisateur sans privilège par base
POSTGRES_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# RabbitMQ : administrateur (management, tests) et un utilisateur par service
RABBITMQ_ADMIN_PASSWORD=change-me
RABBITMQ_CATALOG_PASSWORD=change-me
RABBITMQ_NOTIFICATION_PASSWORD=change-me

# Keycloak : administrateur initial et comptes de démonstration du realm collector
KEYCLOAK_ADMIN_PASSWORD=change-me
ADMIN_PASSWORD=change-me
ALICE_PASSWORD=change-me
BOB_PASSWORD=change-me
CHLOE_PASSWORD=change-me

# Configuration des services (sans secret). L'issuer est l'URL publique de Keycloak ; les clés
# JWKS sont lues par le réseau interne de la pile.
ISSUER=http://localhost:8080/realms/collector
JWKS_URL=http://keycloak:8080/realms/collector/protocol/openid-connect/certs
AUDIENCE=collector-api
CORS_ORIGIN=http://localhost:5173
