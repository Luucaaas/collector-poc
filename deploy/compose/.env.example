# Template of the docker compose stack's .env file. `up.sh` creates .env from this template and
# replaces each `change-me` value with a random password. No real secret here.
# .env is ignored by git; up.sh never overwrites it.

# PostgreSQL: administration superuser and one unprivileged user per database
POSTGRES_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# RabbitMQ: administrator (management, tests) and one user per service
RABBITMQ_ADMIN_PASSWORD=change-me
RABBITMQ_CATALOG_PASSWORD=change-me
RABBITMQ_NOTIFICATION_PASSWORD=change-me

# Keycloak: initial administrator and demo accounts of the collector realm
KEYCLOAK_ADMIN_PASSWORD=change-me
ADMIN_PASSWORD=change-me
ALICE_PASSWORD=change-me
BOB_PASSWORD=change-me
CHLOE_PASSWORD=change-me

# Service configuration (no secret). The issuer is Keycloak's public URL; the JWKS
# keys are read over the stack's internal network.
ISSUER=http://localhost:8080/realms/collector
JWKS_URL=http://keycloak:8080/realms/collector/protocol/openid-connect/certs
AUDIENCE=collector-api
CORS_ORIGIN=http://localhost:5173
