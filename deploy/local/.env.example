# Modèle du fichier deploy/local/.env du cluster k3d. `deploy.sh` crée .env (vide, mode 600) s'il
# n'existe pas, puis y ajoute un mot de passe aléatoire pour chaque variable de ce modèle absente
# ou vide. Les valeurs existantes ne sont jamais modifiées : les mots de passe restent stables
# d'un déploiement à l'autre.
# Aucun secret réel ici. .env est ignoré par git (mode 600).
# Les noms sont ceux de deploy/compose/.env.example : render.py sert aux deux piles.

# PostgreSQL : superutilisateur d'administration et un rôle sans privilège par base
POSTGRES_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# RabbitMQ : administrateur (management) et un utilisateur par service
RABBITMQ_ADMIN_PASSWORD=change-me
RABBITMQ_CATALOG_PASSWORD=change-me
RABBITMQ_NOTIFICATION_PASSWORD=change-me

# Keycloak : administrateur initial et comptes de démonstration du realm collector
KEYCLOAK_ADMIN_PASSWORD=change-me
ADMIN_PASSWORD=change-me
ALICE_PASSWORD=change-me
BOB_PASSWORD=change-me
CHLOE_PASSWORD=change-me

# Grafana : mot de passe du compte `admin` (https://grafana.127.0.0.1.sslip.io)
GRAFANA_ADMIN_PASSWORD=change-me
