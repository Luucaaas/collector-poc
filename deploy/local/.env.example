# Template of the k3d cluster's deploy/local/.env file. `deploy.sh` creates .env (empty, mode 600) if it
# does not exist, then adds a random password for each variable of this template that is missing
# or empty. Existing values are never changed: passwords stay stable
# from one deployment to the next.
# No real secret here. .env is ignored by git (mode 600).
# The names are those of deploy/compose/.env.example: render.py serves both stacks.

# PostgreSQL: administration superuser and one unprivileged role per database
POSTGRES_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# RabbitMQ: administrator (management) and one user per service
RABBITMQ_ADMIN_PASSWORD=change-me
RABBITMQ_CATALOG_PASSWORD=change-me
RABBITMQ_NOTIFICATION_PASSWORD=change-me

# Keycloak: initial administrator and demo accounts of the collector realm
KEYCLOAK_ADMIN_PASSWORD=change-me
ADMIN_PASSWORD=change-me
ALICE_PASSWORD=change-me
BOB_PASSWORD=change-me
CHLOE_PASSWORD=change-me

# Grafana: password of the `admin` account (https://grafana.127.0.0.1.sslip.io)
GRAFANA_ADMIN_PASSWORD=change-me
