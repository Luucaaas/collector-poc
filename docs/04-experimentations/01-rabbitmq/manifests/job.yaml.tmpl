# Modèle de Job : run.sh remplace __NAME__ et __ARGS__ (producteur ou analyse).
apiVersion: batch/v1
kind: Job
metadata:
  name: __NAME__
  namespace: exp
spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: job
          image: exp-rabbitmq-app:local
          imagePullPolicy: Never
          command: __COMMAND__
          env:
            - name: RABBITMQ_HOST
              value: rabbitmq
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: RABBITMQ_USER
              valueFrom:
                secretKeyRef:
                  name: rabbitmq-default-user
                  key: username
            - name: RABBITMQ_PASS
              valueFrom:
                secretKeyRef:
                  name: rabbitmq-default-user
                  key: password
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              memory: 128Mi
