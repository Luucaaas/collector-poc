# Modèle nginx de l'image du front. L'image officielle nginx-unprivileged le passe à envsubst au
# démarrage (script 20-envsubst-on-templates.sh) : le fichier produit est /etc/nginx/conf.d/default.conf.
# Seules les variables CSP_* sont substituées (NGINX_ENVSUBST_FILTER) : $uri, $request_uri, etc. sont
# des variables nginx et restent intactes.

server {
    listen 8080;
    server_name _;

    # Ne pas annoncer la version de nginx (en-tête Server et pages d'erreur).
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Jamais de liste de dossier.
    autoindex off;

    # En-têtes de sécurité (fichier produit par envsubst à partir de security-headers.inc.template).
    # nginx n'hérite pas des add_header du serveur dans un bloc location qui en déclare un :
    # chaque location inclut donc ce fichier.
    include /etc/nginx/conf.d/security-headers.inc;

    # Aucun fichier ou dossier caché (.git, .env, .htaccess...) n'est servi.
    location ~ /\. {
        include /etc/nginx/conf.d/security-headers.inc;
        return 404;
    }

    # Sondes Kubernetes : réponse constante, sans journal d'accès.
    location = /healthz {
        include /etc/nginx/conf.d/security-headers.inc;
        access_log off;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "ok\n";
    }

    # Point d'entrée et configuration d'exécution : toujours revalidés, jamais mis en cache.
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }

    location = /config.json {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
        default_type application/json;
    }

    # Fichiers de Vite : le nom contient l'empreinte du contenu, donc un cache d'un an est sans risque.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        # Sans « always » : une erreur (404) n'est jamais marquée « immutable ».
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Application monopage : toute autre route est résolue côté navigateur par React Router.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
        try_files $uri /index.html;
    }
}
