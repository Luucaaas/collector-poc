# nginx template of the front image. The official nginx-unprivileged image passes it to envsubst at
# startup (script 20-envsubst-on-templates.sh): the resulting file is /etc/nginx/conf.d/default.conf.
# Only the CSP_* variables are substituted (NGINX_ENVSUBST_FILTER): $uri, $request_uri, etc. are
# nginx variables and stay untouched.

server {
    listen 8080;
    server_name _;

    # Do not announce the nginx version (Server header and error pages).
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Never list a directory.
    autoindex off;

    # Security headers (file produced by envsubst from security-headers.inc.template).
    # nginx does not inherit the server's add_header in a location block that declares one:
    # each location therefore includes this file.
    include /etc/nginx/conf.d/security-headers.inc;

    # No hidden file or folder (.git, .env, .htaccess...) is served.
    location ~ /\. {
        include /etc/nginx/conf.d/security-headers.inc;
        return 404;
    }

    # Kubernetes probes: constant response, no access log.
    location = /healthz {
        include /etc/nginx/conf.d/security-headers.inc;
        access_log off;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "ok\n";
    }

    # Entry point and runtime configuration: always revalidated, never cached.
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }

    location = /config.json {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
        default_type application/json;
    }

    # Vite files: the name contains the content hash, so a one-year cache is safe.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        # Without "always": an error (404) is never marked "immutable".
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page application: any other route is resolved in the browser by React Router.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
        try_files $uri /index.html;
    }
}
