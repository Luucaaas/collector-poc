# En-têtes de sécurité, ajoutés à toutes les réponses (always : y compris 404 et 500).
# Les origines de l'API et de Keycloak viennent de CSP_CONNECT_SRC (variable d'environnement du conteneur).

# Politique de contenu : seules les ressources de l'origine sont chargées ; les connexions réseau
# (fetch) ne vont que vers l'origine et les adresses de CSP_CONNECT_SRC.
# style-src 'unsafe-inline' : Emotion (MUI) injecte des balises <style> à l'exécution (limite connue).
# Aucun frame-src : le renouvellement des jetons utilise le jeton de rafraîchissement, pas d'iframe.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self'; connect-src 'self' ${CSP_CONNECT_SRC}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
# Une origine seulement vers un autre site : l'adresse complète (avec ?code= du retour de Keycloak) ne fuit pas.
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" always;
# Un an, sans includeSubDomains ni preload : le domaine de démonstration (sslip.io) n'est pas le nôtre.
add_header Strict-Transport-Security "max-age=31536000" always;
