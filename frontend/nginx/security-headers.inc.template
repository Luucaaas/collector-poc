# Security headers, added to every response (always: including 404 and 500).
# The API and Keycloak origins come from CSP_CONNECT_SRC (container environment variable).

# Content policy: only same-origin resources are loaded; network connections
# (fetch) only go to the origin and the addresses in CSP_CONNECT_SRC.
# style-src 'unsafe-inline': Emotion (MUI) injects <style> tags at runtime (known limitation).
# No frame-src: token renewal uses the refresh token, not an iframe.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ${CSP_CONNECT_SRC}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
# Send only the origin to other sites: the full address (with the ?code= of the Keycloak return) does not leak.
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" always;
# One year, without includeSubDomains or preload: the demo domain (sslip.io) is not ours.
add_header Strict-Transport-Security "max-age=31536000" always;
